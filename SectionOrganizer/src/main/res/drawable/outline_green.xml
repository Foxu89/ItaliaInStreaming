<?xml version="1.0" encoding="utf-8"?>
<!-- Card "positiva" (es. stato abilitato), stesso stile di WatchParty -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#552ECC71" />
            <stroke android:width="2dp" android:color="#2ECC71" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#552ECC71" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="#402ECC71" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#332ECC71" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
