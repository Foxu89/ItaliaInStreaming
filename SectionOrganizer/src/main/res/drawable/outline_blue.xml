<?xml version="1.0" encoding="utf-8"?>
<!-- Card "primaria" (colorAccent CloudStream #3b65f5), stesso stile di WatchParty -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#553B65F5" />
            <stroke android:width="2dp" android:color="#3B65F5" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#553B65F5" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="#403B65F5" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#333B65F5" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
