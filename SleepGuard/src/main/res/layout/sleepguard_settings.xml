<?xml version="1.0" encoding="utf-8"?>
<!-- Pannello impostazioni SleepGuard, stesso stile "card" di Wrapped/WatchParty.
     Nessun android:background="@drawable/..." qui: tutto in codice in
     SleepGuardSettingsFragment.kt, niente colori hardcoded così il pannello
     eredita il tema chiaro/scuro/AMOLED di CloudStream. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="SleepGuard"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:alpha="0.65"
            android:text="Rilevamento inattività durante la riproduzione."
            android:textSize="14sp" />

        <!-- Card timer di inattività -->
        <LinearLayout
            android:id="@+id/sg_timer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Timer di inattività"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sg_timer_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="60 min" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:alpha="0.6"
                android:text="Senza tocchi, pausa e chiede se stai ancora guardando."
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sg_timer_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Card conteggio episodi (beta) -->
        <LinearLayout
            android:id="@+id/sg_episode_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Conteggio episodi (beta)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/sg_episode_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:alpha="0.6"
                android:text="Best-effort: legge il titolo a schermo per capire se è partito un nuovo episodio in Auto-Next, non è un dato ufficiale di CloudStream."
                android:textSize="12sp" />

            <TextView
                android:id="@+id/sg_episode_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="3 episodi" />

            <SeekBar
                android:id="@+id/sg_episode_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Card reset su tasti volume/telecomando (sperimentale) -->
        <LinearLayout
            android:id="@+id/sg_volume_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset su volume/telecomando (sperimentale)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/sg_volume_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:text="Condivide lo stesso aggancio usato dal player per i gesti volume/DPAD: in rari casi può interferire con la navigazione da telecomando."
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/sg_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Chiudi"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
