<?xml version="1.0" encoding="utf-8"?>
<!-- SleepGuard settings panel, same "card" style as Wrapped/WatchParty.
     No android:background="@drawable/..." here: everything is set in code
     in SleepGuardSettingsFragment.kt, no hardcoded colors so the panel
     inherits CloudStream's light/dark/AMOLED theme. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="SleepGuard"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:alpha="0.65"
            android:text="Inactivity detection during playback."
            android:textSize="14sp" />

        <!-- Inactivity timer card -->
        <LinearLayout
            android:id="@+id/sg_timer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Inactivity timer"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sg_timer_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="60 min" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:alpha="0.6"
                android:text="With no touches, pauses and asks if you're still watching."
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/sg_timer_seek_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Episode counter (beta) card -->
        <LinearLayout
            android:id="@+id/sg_episode_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Episode counter (beta)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/sg_episode_toggle_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:alpha="0.6"
                android:text="Best-effort: reads the on-screen title to guess when Auto-Next moves to a new episode, not an official CloudStream signal. Only applies to TV series, not movies."
                android:textSize="12sp" />

            <TextView
                android:id="@+id/sg_episode_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="3 episodes" />

            <FrameLayout
                android:id="@+id/sg_episode_seek_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Volume/remote key reset (experimental) card -->
        <LinearLayout
            android:id="@+id/sg_volume_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset on volume/remote keys (experimental)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/sg_volume_toggle_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:text="Shares the same hook the player uses for volume/D-pad gestures: in rare cases it may interfere with remote-control navigation."
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/sg_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Close"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
