<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="CloudStream Wrapped"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:alpha="0.7"
            android:text="Le tue statistiche di visione, in una card da condividere."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Riquadro anteprima: altezza FISSA (non adjustViewBounds), così il
             box scuro con bordi arrotondati è sempre visibile da subito, anche
             mentre la card è ancora in generazione in background — prima
             l'ImageView non aveva nessuna src iniziale e con adjustViewBounds
             collassava ad altezza zero finché il bitmap non era pronto,
             facendo sembrare il pannello "vuoto"/invisibile. Lo spinner è
             sovrapposto al centro dello stesso riquadro con un FrameLayout. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/wrapped_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wrapped_preview_bg"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/wrapped_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <TextView
            android:id="@+id/wrapped_share"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/wrapped_share_bg"
            android:gravity="center"
            android:text="Share"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wrapped_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/wrapped_outline_bg"
            android:gravity="center"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
