<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:background="@color/cardview_dark_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Watch Party"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Card: stato connessione + partecipanti -->
        <LinearLayout
            android:id="@+id/wp_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/wp_status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@android:drawable/presence_offline" />

                <TextView
                    android:id="@+id/wp_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Apri un video, poi crea una stanza o unisciti con un PIN."
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/wp_participants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Card: PIN + copia (solo host) -->
        <LinearLayout
            android:id="@+id/wp_pin_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/wp_pin_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/wp_copy_pin"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Copia il PIN"
                android:padding="7dp" />

        </LinearLayout>

        <!-- Card: crea/unisciti (stato "non in stanza") -->
        <LinearLayout
            android:id="@+id/wp_join_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/wp_create"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Crea stanza"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/wp_pin_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Inserisci il PIN dell'amico"
                android:inputType="number"
                android:maxLength="6" />

            <Button
                android:id="@+id/wp_join"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="Unisciti alla stanza"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Card: azioni stanza attiva -->
        <LinearLayout
            android:id="@+id/wp_active_room_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <Button
                android:id="@+id/wp_resync"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Risincronizza ora"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <Button
                android:id="@+id/wp_leave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="Esci dalla stanza"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Card: sezione Impostazioni collassabile -->
        <LinearLayout
            android:id="@+id/wp_settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/wp_settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Impostazioni"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/wp_settings_arrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.7"
                    android:src="@android:drawable/arrow_down_float" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/wp_settings_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pulsante invisibile nel player"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:text="Nasconde il pulsante sopra il player ma resta cliccabile nello stesso punto"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/wp_invisible_button"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:showText="false"
                        android:switchMinWidth="28dp"
                        android:text="" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
