<?xml version="1.0" encoding="utf-8"?>
<!--
    Icona chat: due fumetti sovrapposti, quello davanti con 3 puntini "bucati"
    (fillType evenOdd => trasparenti, lasciano vedere il cerchio nero
    semi-transparente dietro, invece di puntini bianchi pieni).
    Ordine dei path = ordine di disegno: il fumetto posteriore va PRIMA,
    così quello anteriore (sopra, opaco) lo ricopre dove si sovrappongono,
    senza bisogno di calcolare l'intersezione esatta tra le due forme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@android:color/white">

    <!-- fumetto posteriore (dietro, a destra) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M17,5 H20 A3,3 0 0 1 23,8 V13 A3,3 0 0 1 20,16 H18.5 L21,20 L19,16 H17 A3,3 0 0 1 14,13 V8 A3,3 0 0 1 17,5 Z" />

    <!-- fumetto anteriore (davanti, a sinistra) con i 3 puntini bucati -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M5,2 H13 A4,4 0 0 1 17,6 V10 A4,4 0 0 1 13,14 H8 L3,19 L4.5,14 H5 A4,4 0 0 1 1,10 V6 A4,4 0 0 1 5,2 Z
                           M3.9,8 A1.1,1.1 0 1 0 6.1,8 A1.1,1.1 0 1 0 3.9,8 Z
                           M6.9,8 A1.1,1.1 0 1 0 9.1,8 A1.1,1.1 0 1 0 6.9,8 Z
                           M9.9,8 A1.1,1.1 0 1 0 12.1,8 A1.1,1.1 0 1 0 9.9,8 Z" />

</vector>
